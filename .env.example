# Salin file ini menjadi .env lalu isi nilainya.
# Contoh: cp .env.example .env

# ---------- Database (wajib untuk MongoDB; kosongkan = fallback JSON) ----------
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/"
MONGODB_DB="gpi_eluzai_kids"

# ---------- Session & admin ----------
# String acak minimal 32 karakter - jangan pernah kosong di produksi.
SESSION_SECRET="ganti-dengan-string-acak-yang-panjang"
ADMIN_PASSWORD="ganti-password-admin"
# Set DISABLE_DEFAULT_ADMIN=1 setelah admin pertama berhasil dibuat.
# DISABLE_DEFAULT_ADMIN=1

# ---------- CORS whitelist (SECURITY.md 3.1) ----------
# Daftar origin yang diizinkan, pisahkan dengan koma (tanpa spasi).
# ALLOWED_ORIGINS="https://domain-anda.com,https://admin.domain-anda.com"
